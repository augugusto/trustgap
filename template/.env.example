# Copiá este archivo a .env y completá con los datos de tu deploy.
# .env no se commitea (está en .gitignore).

# ── red ────────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.base.org

# ── contratos ──────────────────────────────────────────────────────────
# Los imprime contracts/script/Deploy.s.sol cuando deployás.
GOVERNADOR=
TIMELOCK=
DAO_SHARE=
ENS_RESOLVER=
RELEASE_PROPOSAL=

# ── IPFS ───────────────────────────────────────────────────────────────
# Nodo Kubo local. Por defecto el que escucha en tu máquina.
IPFS_API=http://127.0.0.1:5001

# ── firma (sólo para mandar transacciones) ─────────────────────────────
# La llave del proponente. Nunca la subas al repo.
# PROPOSER_PRIVATE_KEY=0x...
